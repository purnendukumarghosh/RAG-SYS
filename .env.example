# NimbusVPN configuration. Copy to .env and edit; never commit the real .env.
# deploy/scripts/install.sh generates this file for you with random secrets.

# --- Required ---------------------------------------------------------------------------
# Master secret (>= 32 chars). Derives the token-signing key and the at-rest encryption key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
NIMBUS_SECRET_KEY=change-me-to-a-long-random-string

# Public DNS name (or IP) that clients connect to and the dashboard is served on.
NIMBUS_DOMAIN=vpn.example.com
NIMBUS_PUBLIC_ENDPOINT=vpn.example.com

# First admin account, created on first start only (when the database has no users).
NIMBUS_ADMIN_USERNAME=admin
NIMBUS_ADMIN_PASSWORD=change-me-to-a-strong-password

# --- WireGuard --------------------------------------------------------------------------
NIMBUS_WG_PORT=51820
NIMBUS_WG_SUBNET_V4=10.8.0.0/24
# Leave empty to disable IPv6 inside the tunnel.
NIMBUS_WG_SUBNET_V6=fd42:4e:42::/64
# NIMBUS_WG_MTU=1420

# --- Client profile ---------------------------------------------------------------------
NIMBUS_CLIENT_DNS=1.1.1.1, 1.0.0.1
# Full tunnel by default (all traffic, both IP families, goes through the VPN).
NIMBUS_CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
NIMBUS_PERSISTENT_KEEPALIVE=25

# --- Security policy --------------------------------------------------------------------
# Stop VPN clients reaching each other.
NIMBUS_CLIENT_ISOLATION=true
# Destinations VPN clients may never reach. 169.254.0.0/16 covers cloud metadata services.
NIMBUS_BLOCKED_DESTINATIONS=169.254.0.0/16
NIMBUS_MAX_DEVICES_PER_USER=5
NIMBUS_ACCESS_TOKEN_TTL_MINUTES=60
NIMBUS_LOGIN_MAX_ATTEMPTS=5
NIMBUS_LOGIN_LOCKOUT_MINUTES=15
NIMBUS_ENABLE_API_DOCS=false
